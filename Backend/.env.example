DATABASE_URL="mysql://root:@localhost:3306/bookstore"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
PAYMENT_RESULT_URL=http://localhost:5173/order-success

# VNPay sandbox; request VNPay to register the IPN URL after deployment.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return

# MoMo sandbox; use the public Backend URLs for both return and IPN.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:5000/api/payments/momo/return
MOMO_NOTIFY_URL=http://localhost:5000/api/payments/momo/ipn
